[Desktop Entry]
Categories={{{categories}}}
Comment={{{comment}}}
Exec=env WEBKIT_DISABLE_DMABUF_RENDERER=1 WEBKIT_DISABLE_COMPOSITING_MODE=1 {{{exec}}} %u
StartupWMClass=clash-verge
Icon={{{icon}}}
Name={{{name}}}
Terminal=false
Type=Application
MimeType=x-scheme-handler/clash;x-scheme-handler/clash-verge;
